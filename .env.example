# ============================================================
# SysMho Hunter — Variables de Entorno (raíz)
# Usado por docker compose (sustitución ${VAR}) y como referencia.
# Copiar valores reales a backend/.env (el backend solo lee backend/.env).
# NUNCA commitear archivos .env con secretos.
# ============================================================

# --- Postgres (Docker Compose + backend) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=sysmho_hunter

# --- LLM local OpenAI-compatible (Nivel 2) ---
# LM Studio: http://localhost:1234/v1  (Local Server ON)
# Ollama OpenAI compat: http://localhost:11434/v1
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=tu-modelo-en-lm-studio
LOCAL_LLM_API_KEY=lm-studio

# --- Embeddings (RAG) — OpenAI-compatible /v1/embeddings ---
# Por defecto usa LOCAL_LLM_BASE_URL si EMBEDDING_BASE_URL está vacío
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DIMENSIONS=768

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=security_knowledge

# --- Cloud (Nivel 3) ---
GEMINI_API_KEY=tu_gemini_api_key_aqui

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=false
SECRET_KEY=cambia_esto_por_una_clave_segura_aleatoria
API_KEY=tu_api_key_super_secreta_cambiar_esto
FRONTEND_URL=http://localhost:5173

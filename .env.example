# ============================================================
# SysMho Hunter — Variables de Entorno
# Copiar a .env y completar con valores reales
# NUNCA commitear el archivo .env
# ============================================================

# --- Base de Datos PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=sysmho_hunter

# --- APIs de IA (cloud fallback) ---
GEMINI_API_KEY=tu_gemini_api_key_aqui
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui

# --- Ollama (LLM local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q6_K

# --- Configuración del Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false
SECRET_KEY=cambia_esto_por_una_clave_segura_aleatoria

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- HackerOne (opcional, para submission directa) ---
H1_API_TOKEN=tu_h1_api_token_aqui
H1_USERNAME=tu_username_h1

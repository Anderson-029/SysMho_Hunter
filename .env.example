# SysMho Hunter - Variables de Entorno
# Copia este archivo como .env y completa con tus claves

# API Key para Google Gemini
GEMINI_API_KEY=tu_api_key_aqui

# Configuración del servidor
HOST=127.0.0.1
PORT=8000

# Base de datos PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=xxxxx
DB_PASSWORD=xxxx
DB_NAME=sysmho_hunter

# Configuración del agente
MAX_CONCURRENT_SCANS=3
DEFAULT_RATE_LIMIT=10
SCAN_TIMEOUT=300

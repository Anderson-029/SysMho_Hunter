# ============================================================
# SysMho Hunter — Variables de Entorno
# Copiar a backend/.env y completar con valores reales
# NUNCA commitear el archivo .env
# ============================================================

# --- Base de Datos PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=sysmho_hunter

# --- APIs de IA (cloud — Nivel 3 del cerebro) ---
# Obtener en: https://aistudio.google.com/app/apikey
# Nota: el plan gratuito tiene límite de requests por minuto.
# Si se agota la cuota, el sistema retorna un aviso y espera reintento.
GEMINI_API_KEY=tu_gemini_api_key_aqui

# --- Ollama (LLM local — Nivel 2 del cerebro) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q6_K

# --- Configuración del Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false
SECRET_KEY=cambia_esto_por_una_clave_segura_aleatoria

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

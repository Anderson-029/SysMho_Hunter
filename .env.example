# SysMho Hunter — configuración del CLI
# Copia este archivo a .env y rellena los valores. NUNCA commitees .env.

# --- Cerebro: Nivel 3 (Gemini cloud, fallback) ---
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Cerebro: Nivel 2 (Ollama, LLM local) ---
OLLAMA_BASE_URL=http://localhost:11434
# Modelo por defecto / fallback (ligero)
OLLAMA_MODEL=llama3.1:8b-instruct-q6_k

# Agentes especializados del Nivel 2 (modelo por rol).
# Si un modelo no está instalado, el cerebro degrada a OLLAMA_MODEL.
AGENT_RECON_MODEL=qwen3:14b
AGENT_CODE_MODEL=qwen2.5-coder:14b
AGENT_REPORT_MODEL=mistral-small3.2:24b-instruct-2506-q4_K_M
AGENT_PAYLOAD_MODEL=dolphin-mixtral:8x7b

# --- RAG: Qdrant + embeddings ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=security_knowledge
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# --- Operación ---
DEBUG=false
MAX_CONCURRENT_TOOLS=5

# SysMho Hunter — Backend Environment Configuration
# Copy this file to .env and fill in real values for your environment
# DO NOT commit .env to git (it's in .gitignore)

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=sysmho_hunter

# External API Keys (for cloud fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# API Security
API_KEY=your_random_api_key_here

# JWT & Security
SECRET_KEY=your_random_jwt_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin User (used by scripts/create_admin.py)
# Generate a strong password: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sysmho.local
ADMIN_PASSWORD=your_strong_password_here

# RAG - Qdrant (vector DB) + embeddings
# Qdrant corre local vía docker-compose.yml (puerto 6333)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=security_knowledge
# Modelo de embeddings servido por Ollama (ollama pull nomic-embed-text)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# SysMho Hunter — Backend Environment Configuration
# Copy this file to .env and fill in real values for your environment
# DO NOT commit .env to git (it's in .gitignore)

# Database Configuration (Postgres del docker compose)
DB_HOST=127.0.0.1
# Debe coincidir con DB_PUBLISH_PORT del docker-compose (default 5433)
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=sysmho_hunter

# External API Keys (cloud fallback — Nivel 3)
GEMINI_API_KEY=your_gemini_api_key_here

# API Security
API_KEY=your_random_api_key_here

# JWT & Security
SECRET_KEY=your_random_jwt_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin User (used by scripts/create_admin.py)
# Generate a strong password: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sysmho.local
ADMIN_PASSWORD=your_strong_password_here

# --- LLM local OpenAI-compatible (Nivel 2 del cerebro) ---
# LM Studio: carga un modelo, activa Local Server, usa esta URL
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=your-chat-model-id
LOCAL_LLM_API_KEY=lm-studio

# RAG - Qdrant (vector DB) + embeddings OpenAI-compatible
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=security_knowledge
# Vacío = mismo endpoint que LOCAL_LLM_BASE_URL
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DIMENSIONS=768

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=false
FRONTEND_URL=http://localhost:5173
